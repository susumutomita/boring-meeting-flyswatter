# Supply-chain hardening — blocks the mini-shai-hulud 2nd wave attack vector
# (Flatt Tech, 2026-05-12: optionalDependencies + prepare-script worm).
#
# Why these flags:
#   ignore-scripts        — never run preinstall/install/postinstall/prepare from
#                           dependencies; the worm propagates via prepare scripts.
#   minimum-release-age   — refuse versions younger than 7 days, so a freshly
#                           hijacked release cannot land on a developer machine
#                           before the registry has a chance to take it down.
#                           Honoured by npm >=11. Express in seconds.
#   audit-level=high      — `npm audit` exits non-zero on high/critical only.
#   fund=false            — quieter logs so warnings stand out.

ignore-scripts=true
minimum-release-age=10080
audit-level=high
fund=false
